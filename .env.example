# Supabase project URL and anon key — safe to expose to the browser.
# Each partner provisions their own Supabase project and pastes their values here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER expose to the browser.
# Used by /api/auth/* and any server-only data access.
# Find it in: Supabase Dashboard → Project Settings → API → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT signing secret for the session cookie. Generate with: openssl rand -base64 32
# Use the SAME value locally and in Vercel env vars so sessions work in deploys.
JWT_SECRET=generate-a-32-byte-base64-string
