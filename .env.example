# Supabase project URL and anon key — safe to expose to the browser.
# Each partner provisions their own Supabase project and pastes their values here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never exposed to the browser.
# Used by /api/* routes (Phase 2). Set this in Vercel env vars, not in committed files.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
